# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Secrets / local env (never commit credentials)
.env

# Benchmark run artifacts (local-validation output, gitignored manifests)
*.run.json
*.task.json
results/

# Data caches (Hugging Face / local downloads)
.cache/
data/

# Generated reports / briefings — but keep the committed sample(s) in examples/
*.html
!examples/*.html
!docs/index.html
# `auditor brief` defaults to writing briefing.md in the cwd; ignore those scratch
# outputs at the repo root while keeping the curated examples/ copies tracked.
/briefing*.md

# Personal at-a-glance status view for the status line / project-status skill.
# Overlaps ROADMAP.md + CHANGELOG.md (the tracked sources of truth); kept local-only.
/TASKS.md

# Social / marketing assets — kept in-repo for convenience but not part of the
# published project (rendered card + crops live here, regenerated from explainer.html).
docs/social/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local Claude Code settings (machine-specific permission allowlist)
.claude/

# scratch outputs of benchmarks/_grow/grow.py (regenerable)
benchmarks/_grow/*_candidates.jsonl

# Fresh PRIVATE Kaggle held-out set — must NEVER be committed/published, or it stops
# being a contamination-free hold-out. Generator + emitted task files live here.
kaggle/private/

# Throwaway venv for Kaggle SDK exploration
.kaggle-scratch-venv/
